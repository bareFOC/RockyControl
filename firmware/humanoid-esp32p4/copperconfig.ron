(
    // Identical Copper-rs DAG to RP2350 — zero control-logic divergence across MCUs.
    tasks: [
        (
            id: "servo_ctrl",
            type: "humanoid_fw_core::copper::DirectServoCuTask",
            config: {
                "joint_count": 17,
            },
        ),
    ],
    bridges: [
        // Wired USB-OTG High-Speed (480 Mbps CDC-ACM or CDC-NCM UDP 10.42.0.2:7777)
        (
            id: "host_link",
            type: "humanoid_fw_core::copper::HostLinkBridge",
            channels: [
                Rx(id: "rx_cmd"),
                Tx(id: "tx_telem"),
            ],
        ),
        // Servo actuator bus (BenchLoopbackBus on Day 1, ESP32-P4 UART/TWAI in Stage 2.2)
        (
            id: "servo_bus",
            type: "humanoid_fw_core::copper::ServoBusBridge",
            channels: [
                Rx(id: "rx_state"),
                Tx(id: "tx_cmd"),
            ],
        ),
    ],
    cnx: [
        (src: "host_link/rx_cmd", dst: "servo_ctrl", msg: "humanoid_fw_core::copper::HostCmdMsg"),
        (src: "servo_bus/rx_state", dst: "servo_ctrl", msg: "humanoid_fw_core::copper::ServoFeedbackMsg"),
        (src: "servo_ctrl", dst: "servo_bus/tx_cmd", msg: "humanoid_fw_core::copper::ControlStepMsg"),
        (src: "servo_ctrl", dst: "host_link/tx_telem", msg: "humanoid_fw_core::copper::ControlStepMsg"),
    ],
    logging: (
        enable_task_logging: false,
    ),
)
