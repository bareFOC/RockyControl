<?xml version="1.0"?>
<robot name="rocky_mk1">
  <!--
    Per-link mass properties (authored BOM estimates, 2026-11-24).
    Rocky Mk1 is a ~45 cm, ~1.5 kg 1/4-scale humanoid. Total mass of all
    22 <inertial> blocks below: 1.487 kg. Torso/pelvis dominate; limbs
    taper distally. COM origins are near each link's geometric center.
    These URDF tags are the single source of truth; the checked-in table
    crates/rk-control/src/mass_table.rs is generated from them and verified
    by crates/rk-model/tests/mass_table_test.rs.
  -->
  <!-- Pelvis / Root -->
  <link name="pelvis">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.380" />
      <inertia ixx="0.00100" ixy="0" ixz="0" iyy="0.00080" iyz="0" izz="0.00070" />
