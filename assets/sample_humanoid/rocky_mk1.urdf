<?xml version="1.0"?>
<robot name="rocky_mk1">
  <!-- Pelvis / Root -->
  <link name="pelvis">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.22 0.11 0.14" /></geometry>
      <material name="titanium_dark"><color rgba="0.22 0.25 0.30 1.0" /></material>
    </visual>
  </link>

  <!-- Torso & Head -->
  <link name="torso">
    <visual>
      <origin xyz="0 0.16 0" rpy="0 0 0" />
      <geometry><box size="0.28 0.30 0.17" /></geometry>
      <material name="armor_slate"><color rgba="0.30 0.35 0.42 1.0" /></material>
    </visual>
  </link>
  <joint name="waist_yaw" type="revolute">
    <parent link="pelvis" />
    <child link="torso" />
    <origin xyz="0 0.08 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.05" upper="1.05" effort="24.0" velocity="6.0" />
  </joint>

  <link name="neck">
    <visual>
      <origin xyz="0 0.03 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.042" length="0.06" /></geometry>
      <material name="servo_ring"><color rgba="0.18 0.21 0.26 1.0" /></material>
    </visual>
  </link>
  <joint name="head_yaw" type="revolute">
    <parent link="torso" />
    <child link="neck" />
    <origin xyz="0 0.33 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1.22" upper="1.22" effort="10.0" velocity="6.0" />
  </joint>

  <link name="head">
    <visual>
      <origin xyz="0 0.08 0.01" rpy="0 0 0" />
      <geometry><box size="0.14 0.14 0.15" /></geometry>
      <material name="visor_shell"><color rgba="0.34 0.39 0.47 1.0" /></material>
    </visual>
  </link>
  <joint name="head_pitch" type="revolute">
    <parent link="neck" />
    <child link="head" />
    <origin xyz="0 0.06 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.52" upper="0.61" effort="10.0" velocity="6.0" />
  </joint>

  <!-- Left Arm -->
  <link name="l_shoulder">
    <visual>
      <origin xyz="0.03 0 0" rpy="0 0 0" />
      <geometry><cylinder radius="0.052" length="0.08" /></geometry>
