  </link>
  <joint name="l_shoulder_pitch" type="revolute">
    <parent link="torso" />
    <child link="l_shoulder" />
    <origin xyz="0.18 0.27 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-2.45" upper="1.40" effort="22.0" velocity="6.0" />
  </joint>

